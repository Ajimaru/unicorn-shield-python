    {"id":"fn_mane","type":"function","z":"ushield_tab","name":"-> /all?r&g&b","func":"var c = msg.payload;\n// ui_colour_picker object output: {r,g,b}\nvar r = Math.round(c.r), g = Math.round(c.g), b = Math.round(c.b);\nmsg.url = 'http://127.0.0.1:5000/all?r=' + r + '&g=' + g + '&b=' + b;\nreturn msg;","outputs":1,"noerr":0,"x":330,"y":100,"wires":[["req_generic"]]},

    {"id":"sl_bright","type":"ui_slider","z":"ushield_tab","name":"Brightness","label":"Brightness","tooltip":"","group":"ui_group_mane","order":2,"width":6,"height":1,"passthru":true,"outs":"end","topic":"","min":0,"max":100,"step":5,"x":110,"y":150,"wires":[["fn_bright"]]},
    {"id":"fn_bright","type":"function","z":"ushield_tab","name":"-> /brightness","func":"var v = (Number(msg.payload) || 0) / 100.0;\nif (v < 0) v = 0; if (v > 1) v = 1;\nmsg.url = 'http://127.0.0.1:5000/brightness?value=' + v.toFixed(2);\nreturn msg;","outputs":1,"noerr":0,"x":330,"y":150,"wires":[["req_generic"]]},

