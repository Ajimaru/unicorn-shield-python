    {"id":"req_nose","type":"http request","z":"ushield_tab","name":"/nose","method":"GET","ret":"obj","paytoqs":"ignore","url":"http://127.0.0.1:5000/nose","tls":"","persist":false,"proxy":"","authType":"","x":270,"y":590,"wires":[["fn_nose"]]},
    {"id":"fn_nose","type":"function","z":"ushield_tab","name":"charge time -> light %","func":"// charge time: ~0.15s bright ... ~0.8s dark. Map to 0..100 (higher = brighter).\nvar t = (msg.payload && msg.payload.data) ? Number(msg.payload.data) : 0;\nvar lo = 0.15, hi = 0.8;\nvar frac = (hi - t) / (hi - lo);\nif (frac < 0) frac = 0; if (frac > 1) frac = 1;\n// clean msg: chart needs a stable topic + numeric payload, nothing else\nreturn { topic: \"light\", payload: Math.round(frac * 100) };","outputs":1,"noerr":0,"x":460,"y":590,"wires":[["g_light","ch_light"]]},
    {"id":"g_light","type":"ui_gauge","z":"ushield_tab","name":"Light gauge","group":"ui_group_sensors","order":1,"width":6,"height":4,"gtype":"gage","title":"Light","label":"%","format":"{{value}}","min":0,"max":100,"colors":["#111133","#7799ff","#ffee88"],"seg1":"","seg2":"","x":680,"y":580,"wires":[]},
    {"id":"ch_light","type":"ui_chart","z":"ushield_tab","name":"Light chart","group":"ui_group_sensors","order":2,"width":6,"height":4,"label":"Light history","chartType":"line","legend":"false","xformat":"HH:mm:ss","interpolate":"linear","nodata":"","dot":false,"ymin":"0","ymax":"100","removeOlder":"5","removeOlderPoints":"","removeOlderUnit":"60","cutout":0,"useOneColor":false,"colors":["#1f77b4"],"x":680,"y":620,"wires":[[]]},
    {"id":"req_ear","type":"http request","z":"ushield_tab","name":"/ear","method":"GET","ret":"obj","paytoqs":"ignore","url":"http://127.0.0.1:5000/ear","tls":"","persist":false,"proxy":"","authType":"","x":270,"y":660,"wires":[["fn_ear"]]},
    {"id":"fn_ear","type":"function","z":"ushield_tab","name":"button -> text","func":"var pressed = msg.payload && msg.payload.data === true;\nmsg.payload = pressed ? 'PRESSED' : 'released';\nreturn msg;","outputs":1,"noerr":0,"x":460,"y":660,"wires":[["txt_ear"]]},
    {"id":"txt_ear","type":"ui_text","z":"ushield_tab","name":"Button state","group":"ui_group_sensors","order":3,"width":6,"height":1,"label":"Button (B1):","format":"{{msg.payload}}","layout":"row-spread","x":680,"y":660,"wires":[]},

    {"id":"req_generic","type":"http request","z":"ushield_tab","name":"API call (msg.url)","method":"GET","ret":"txt","paytoqs":"ignore","url":"","tls":"","persist":false,"proxy":"","authType":"","x":600,"y":250,"wires":[["dbg_api"]]},
