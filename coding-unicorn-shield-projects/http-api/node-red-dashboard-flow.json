    {"id":"dd_pixel","type":"ui_dropdown","z":"ushield_tab","name":"Pixel #","label":"Pixel #","tooltip":"","place":"Select pixel 0-8","group":"ui_group_pixel","order":1,"width":6,"height":1,"passthru":true,"multiple":false,"options":[{"label":"0","value":0,"type":"num"},{"label":"1","value":1,"type":"num"},{"label":"2","value":2,"type":"num"},{"label":"3","value":3,"type":"num"},{"label":"4","value":4,"type":"num"},{"label":"5","value":5,"type":"num"},{"label":"6","value":6,"type":"num"},{"label":"7","value":7,"type":"num"},{"label":"8","value":8,"type":"num"}],"payload":"","topic":"","x":110,"y":380,"wires":[["fn_store_pixel"]]},
    {"id":"fn_store_pixel","type":"function","z":"ushield_tab","name":"store pixel id","func":"flow.set('pixelId', Number(msg.payload));\nreturn null;","outputs":1,"noerr":0,"x":340,"y":380,"wires":[[]]},
    {"id":"cp_pixel","type":"ui_colour_picker","z":"ushield_tab","name":"Pixel colour","label":"Pixel colour","group":"ui_group_pixel","order":2,"width":6,"height":4,"format":"rgb","outformat":"object","showSwatch":true,"showPicker":true,"showValue":true,"showHue":false,"showLightness":true,"showAlpha":false,"square":"false","dynOutput":"false","x":110,"y":430,"wires":[["fn_pixel"]]},
    {"id":"fn_pixel","type":"function","z":"ushield_tab","name":"-> /pixel/<id>","func":"var id = flow.get('pixelId');\nif (id === undefined || id === null) { node.warn('Pick a pixel # first'); return null; }\nvar c = msg.payload;\nvar r = Math.round(c.r), g = Math.round(c.g), b = Math.round(c.b);\nmsg.url = 'http://127.0.0.1:5000/pixel/' + id + '?r=' + r + '&g=' + g + '&b=' + b;\nreturn msg;","outputs":1,"noerr":0,"x":340,"y":430,"wires":[["req_generic"]]},

